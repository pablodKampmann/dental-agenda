{
  "rules": {
    "admins": {
      ".read": true,
      "$uid": { ".write": "$uid === auth.uid" }
    },
    "clinics": {
      "$clinic_id": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id",

        "appointments": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id"
        },

        "patients": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id",
          ".indexOn": ["timestamp", "name", "dni", "lastName"]
        },

        "priceTariffs": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id"
        },

        "pros": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id"
        },

        "insurances": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id"
        },

        "info": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id"
        },

        "odontogramas": {
          "$pacienteId": {
            "actual": {
              ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id"
            },
            "eventos": {
              "$evt": {
                ".write": "auth != null && root.child('admins').child(auth.uid).child('clinicId').val() === $clinic_id && !data.exists()",
                ".validate": "newData.hasChildren(['ts','uid','alcance','capa']) && newData.child('ts').val() == now && newData.child('uid').val() == auth.uid && (newData.child('alcance').val() == 'CARA' || newData.child('alcance').val() == 'DIENTE' || newData.child('alcance').val() == 'MULTI') && (newData.child('capa').val() == 'existente' || newData.child('capa').val() == 'requerida') && (newData.hasChild('diente') || newData.hasChild('piezas'))"
              }
            }
          }
        }
      }
    }
  }
}
